        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "strategy": {
            "$ref": "#/components/schemas/RetryStrategy"
          },
          "base_delay_seconds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Base Delay Seconds",
            "default": 10
          },
          "max_delay_seconds": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Delay Seconds",
            "default": 3600
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Attempts",
            "default": 3
          }
        },
        "type": "object",
        "required": [
          "name",
          "project_id",
          "strategy"
        ],
        "title": "RetryPolicyCreate"
      },
      "RetryPolicyResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "strategy": {
            "$ref": "#/components/schemas/RetryStrategy"
          },
          "base_delay_seconds": {
            "type": "integer",
            "title": "Base Delay Seconds"
          },
          "max_delay_seconds": {
            "type": "integer",
            "title": "Max Delay Seconds"
          },
          "max_attempts": {
            "type": "integer",
            "title": "Max Attempts"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
