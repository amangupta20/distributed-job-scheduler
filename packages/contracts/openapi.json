        "type": "object",
        "required": [
          "id",
          "project_id",
          "name",
          "strategy",
          "base_delay_seconds",
          "max_delay_seconds",
          "max_attempts",
          "created_at",
          "updated_at"
        ],
        "title": "RetryPolicyResponse"
      },
